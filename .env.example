# Configuracoes do Firebase. Copie para .env.local e preencha com o SEU projeto.
# NUNCA commite .env.local (esta no .gitignore). Nao existe segredo real neste arquivo.
#
# Onde obter: console do Firebase > Configuracoes do projeto > Seus aplicativos > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional, somente desenvolvimento local: true força projeto demo e emuladores loopback.
VITE_FIREBASE_USAR_EMULADORES=false

# Autenticacao por email/senha exige habilitar o provedor em
# Authentication > Sign-in method. Nao usar chaves de servico no cliente.
